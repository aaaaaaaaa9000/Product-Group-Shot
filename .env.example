# Required: Gemini API key (server-side only, never sent to the browser)
GEMINI_API_KEY=

# Image generation model (default: gemini-3.1-flash-lite-image)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Image model for the 2K / 4K quality options (slower, costs more per image)
GEMINI_HQ_IMAGE_MODEL=gemini-3.1-flash-image
# Text model used to describe the optional style reference image
GEMINI_MODEL=gemini-3.8-flash

# Optional in-page login form + session cookie. Leave APP_PASSWORD empty to disable.
APP_USERNAME=user
APP_PASSWORD=

# Abuse limits
RATE_LIMIT_PER_MINUTE=30
MAX_IMAGE_MB=12
# Most products allowed in one group shot
MAX_GROUP_IMAGES=8
MAX_PROMPT_CHARS=4000

# Server port (default 3000)
PORT=3000

# Domain used by Traefik in docker-compose.yml
APP_DOMAIN=products.aaaaaaaaa9000.cloud
# Days a login stays valid on a device
SESSION_DAYS=180
# Optional signing key for session cookies (defaults to one derived from the password)
SESSION_SECRET=
